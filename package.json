{
  "name": "mock-knight-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "tokens": "python3 design/design-tokens.py",
    "tokens:css": "python3 design/design-tokens.py --css > packages/web/src/styles/tokens.css",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "dev:server": "pnpm --filter mock-knight dev",
    "dev:web": "pnpm --filter @mock-knight/web dev",
    "build": "pnpm --filter @mock-knight/web build && pnpm --filter mock-knight build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
