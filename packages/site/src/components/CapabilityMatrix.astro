---
/**
 * The site's organising device: which backend can answer which question, and why not when it
 * can't. One job — render the data in `backends.ts` as a table. It does not decide what the
 * capabilities are; `backends.ts` and its test own that.
 *
 * `only` renders one backend's column (a backend page showing just itself); omitted, it shows
 * all four side by side (the comparison view). Either way every row states its reason when off
 * — colour is never the only signal, so the page still reads correctly in black and white.
 *
 * A capability can also be *on* but conditional (`backends.ts`'s `onIf` — Mockoon's traffic log,
 * present only once the admin API token is configured). Rendering that identically to an
 * unconditional yes — same green, same glyph, same "Yes" — left only the prose note disagreeing,
 * which inherited the same colour anyway. `conditional` is a third `data-state`, with its own
 * glyph and label, so the default path's reader is never shown a plain "Yes" for something they
 * have not yet done.
 */
import { BACKENDS, CAPABILITY_ORDER, type Capability } from '../lib/backends.js'
import { href } from '../lib/href.js'

interface Props {
  /** One backend's column, or every backend side by side. */
  only?: string
}

const { only } = Astro.props
const shown = only === undefined ? BACKENDS : BACKENDS.filter((b) => b.slug === only)

/** One string, used for both the visible `<caption>` and the scroll wrapper's `aria-label`, so
 *  the two can never say something different — see `table-scroll` in site.css. */
const caption =
  'What each backend can answer. A capability that is off says why. So does one that is on only with setup.'

/** `on` with a note is present, but only once the reader has done something the default path
 *  does not — that is not the same claim as an unconditional `on`, so it gets its own state. */
function stateOf(capability: Capability): 'on' | 'off' | 'conditional' {
  if (capability.state === 'off') return 'off'
  return capability.note !== null ? 'conditional' : 'on'
}

function glyphOf(capability: Capability): string {
  const state = stateOf(capability)
  if (state === 'off') return '✗'
  if (state === 'conditional') return '~'
  return '✓'
}

function labelOf(capability: Capability): string {
  const state = stateOf(capability)
  if (state === 'off') return 'No'
  if (state === 'conditional') return 'Yes, with setup'
  return 'Yes'
}
---

<div class="table-scroll" role="region" aria-label={caption} tabindex="0">
  <table class="capabilities">
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Capability</th>
        {
          shown.map((backend) => (
            <th scope="col">
              <a href={href(`/${backend.slug}/`)}>{backend.name}</a>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        CAPABILITY_ORDER.map((label, index) => (
          <tr>
            <th scope="row">{label}</th>
            {shown.map((backend) => {
              const capability = backend.capabilities[index]!
              return (
                <td data-state={stateOf(capability)}>
                  <span aria-hidden="true">{glyphOf(capability)}</span>
                  <span>{labelOf(capability)}</span>
                  {capability.note !== null && <p class="why">{capability.note}</p>}
                </td>
              )
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
