---
/**
 * Renders one level of `schema/mock-knight.schema.json` as a table: field, type, required,
 * description. Copied in at build time by `prepare-assets.mjs` (invariant 1 — this package
 * imports nothing from `@mock-knight/server`, and the schema is generated there).
 *
 * `at` is a dotted path into the schema, or omitted for the document root. A JSON Schema array
 * (`profiles`, and any array nested under it) puts its element's `properties` under `items`
 * rather than on the array node itself — the array node's own `properties` is empty or absent.
 * `unwrapArray` follows `.items` until it reaches the actual object schema, and every step of
 * the path (not just the final one) goes through it before its `properties` are indexed, so a
 * deeper path like `profiles.something` descends past an array at any level, not only the last.
 * Skipping that hop for the *final* resolved node — falling through to `.items` only when a key
 * lookup misses — is exactly the bug this component shipped with: `at="profiles"` resolved to
 * the array node itself, whose `properties` is empty, so the table rendered a header with no
 * rows.
 */
import schema from '../generated/mock-knight.schema.json'

interface JsonSchemaNode {
  type?: string | string[]
  description?: string
  default?: unknown
  properties?: Record<string, JsonSchemaNode>
  items?: JsonSchemaNode
  required?: string[]
  anyOf?: JsonSchemaNode[]
  oneOf?: JsonSchemaNode[]
}

interface Props {
  /** Dotted path into the schema, or omitted for the document root. */
  at?: string
  /** Names this table, for both the visible `<caption>` and the scroll wrapper's `aria-label` —
   *  the two page instances (top level, `profiles`) describe different fields, so this can't be
   *  a fixed string the way `CapabilityMatrix`'s is. */
  caption: string
}

const { at, caption } = Astro.props
const root = schema as unknown as JsonSchemaNode

/** Follow `.items` until the node is no longer an array wrapper, so its `properties` is real. */
function unwrapArray(node: JsonSchemaNode): JsonSchemaNode {
  let current = node
  while (current.items !== undefined) current = current.items
  return current
}

const node =
  at === undefined
    ? root
    : at.split('.').reduce<JsonSchemaNode>((current, key) => {
        const next = unwrapArray(current).properties?.[key]
        if (next === undefined) throw new Error(`No "${key}" in the schema at "${at}".`)
        return next
      }, root)
const resolved = unwrapArray(node)

const fields = Object.entries(resolved.properties ?? {})
const required = new Set(resolved.required ?? [])

/**
 * A nullable field (`adminPath`, `authSecret`, …) compiles to `anyOf: [{type: 'string'}, {type:
 * 'null'}]` rather than a plain `type`, because zod's `.nullable()` has no single-`type` JSON
 * Schema equivalent. Unwrapping it into `string | null` is what makes the column honest — the
 * unwrapped-away version rendered `any`, which tells a reader the field accepts arbitrary JSON
 * (an object, a number, an array) rather than a tightly constrained nullable string. `'any'`
 * stays only as the genuine last resort, for a branch this generator does not otherwise emit.
 */
const typeOf = (field: JsonSchemaNode): string => {
  if (field.type !== undefined)
    return Array.isArray(field.type) ? field.type.join(' | ') : field.type
  const branches = field.anyOf ?? field.oneOf
  if (branches !== undefined) return branches.map(typeOf).join(' | ')
  return 'any'
}
---

<div class="table-scroll" role="region" aria-label={caption} tabindex="0">
  <table class="schema">
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Field</th>
        <th scope="col">Type</th>
        <th scope="col">Required</th>
        <th scope="col">What it does</th>
      </tr>
    </thead>
    <tbody>
      {
        fields.map(([name, field]) => (
          <tr>
            <td>
              <code>{name}</code>
            </td>
            <td>{typeOf(field)}</td>
            <td>{required.has(name) ? 'Yes' : 'No'}</td>
            <td>{field.description ?? '—'}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
