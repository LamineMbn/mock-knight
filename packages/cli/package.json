{
  "name": "mock-knight",
  "version": "0.0.0",
  "description": "A local-first web UI for HTTP mock servers",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "mock-knight": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
