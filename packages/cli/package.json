{
  "name": "mock-knight",
  "version": "0.5.0",
  "description": "A local-first web UI for HTTP mock servers",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "mock-knight": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/bundle-web.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^13.0.0",
    "undici": "^7.2.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@mock-knight/server": "workspace:*",
    "@mock-knight/web": "workspace:*",
    "tsx": "^4.19.2"
  },
  "keywords": [
    "wiremock",
    "mock-server",
    "http-mock",
    "api-mocking",
    "stub",
    "devtools",
    "testing"
  ],
  "author": "Lamine Bendib",
  "homepage": "https://github.com/LamineMbn/mock-knight#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LamineMbn/mock-knight.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/LamineMbn/mock-knight/issues"
  }
}
