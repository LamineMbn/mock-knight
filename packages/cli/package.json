    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@mock-knight/server": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^13.0.0",
    "undici": "^7.2.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
