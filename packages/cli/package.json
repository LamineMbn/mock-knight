{
  "name": "mock-knight",
  "version": "0.7.2",
  "description": "Web UI for WireMock, MockServer, Mockoon and Prism \u2014 search, edit and debug HTTP mock stubs in the browser. Runs locally with npx.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "mock-knight": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/bundle-web.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^13.0.0",
    "js-yaml": "^4.1.0",
    "undici": "^7.2.0"
  },
  "devDependencies": {
    "@mock-knight/server": "workspace:*",
    "@mock-knight/web": "workspace:*",
    "tsx": "^4.19.2"
  },
  "keywords": [
    "wiremock",
    "wiremock-ui",
    "wiremock-gui",
    "wiremock-admin",
    "mockserver",
    "mockoon",
    "prism",
    "openapi",
    "mock-server",
    "mock-server-ui",
    "mock-ui",
    "mock-api",
    "api-mocking",
    "http-mock",
    "http-mocking",
    "api-testing",
    "stub",
    "stub-management",
    "test-doubles",
    "devtools"
  ],
  "author": "Lamine Bendib",
  "homepage": "https://github.com/LamineMbn/mock-knight#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LamineMbn/mock-knight.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/LamineMbn/mock-knight/issues"
  }
}
