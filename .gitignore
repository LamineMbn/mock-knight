# Design and planning documents. These drive the work but are not part of the shipped project,
# and they are large enough to bury real changes in a diff. They stay on disk; git ignores them.
#
# `design/design-tokens.py` is deliberately NOT here: it is a build tool, not a document. It
# generates the palette and `packages/web/src/styles/tokens.css` via `pnpm tokens:css`, and CI
# fails if the committed CSS does not match what it emits.
CLAUDE.md
PRD.md
TECH-DESIGN.md
design/DESIGN-BRIEF.md
design/CLAUDE-DESIGN-PROMPT.md

# Copied from the repo root at build time so npm ships them inside the tarball.
packages/cli/README.md
packages/cli/LICENSE

# Copied into the site package at build time by packages/site/scripts/prepare-assets.mjs.
# The committed originals are packages/web/src/styles/tokens.css, docs/images/, and
# schema/mock-knight.schema.json.
packages/site/src/styles/tokens.generated.css
packages/site/public/images/
packages/site/src/generated/

# The Mockoon environment scripts/capture-screenshots.mts seeds for its corpus screenshot. A
# runtime artifact of running the script, not a fixture — see the script's header comment.
/.mockoon/
